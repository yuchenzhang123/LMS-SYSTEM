# ===========================================
# 开发环境（webpack-dev-server + proxy）
# ===========================================
NODE_ENV=development
VUE_APP_ENV=development
VUE_APP_TITLE=催收管理系统 - 开发环境
VUE_APP_SYS_ID=GDLWXT

# 认证（开发环境关闭 SSO 校验）
VUE_APP_ENABLE_SSO_GUARD=false
VUE_APP_OAUTH_CLIENT_ID=frontend
VUE_APP_OAUTH_CLIENT_SECRET=frontend_secret

# 请求前缀（devServer 代理用）
VUE_APP_API_PREFIX=/api
VUE_APP_SSO_PREFIX=/ssoservice
VUE_APP_OAUTH_PREFIX=/oauth

# devServer 代理目标
VUE_APP_API_TARGET=http://localhost:8099
VUE_APP_SSO_TARGET=http://22.156.22.42:8098
VUE_APP_MODEL_PREFIX=/modelservice
VUE_APP_MODEL_TARGET=http://22.156.22.42:8099

# SSO 登录页（仅开发环境 fallback，生产/测试由 Nginx sub_filter 注入 window.__SSO_LOGIN_URL__）
VUE_APP_SSO_LOGIN_URL=http://22.156.22.42:8098

# devServer 绑定
VUE_APP_DEV_HOST=0.0.0.0
VUE_APP_DEV_PORT=8080

# VUE_APP_COOKIE_DOMAIN=
# VUE_APP_DISABLE_LOGIN_REDIRECT=true
