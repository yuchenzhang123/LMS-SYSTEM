# ===========================================
# 生产环境（Nginx 反向代理，无需 devServer）
# ===========================================
NODE_ENV=production
VUE_APP_ENV=production
VUE_APP_TITLE=催收管理系统
VUE_APP_SYS_ID=lms-prod

# 认证
VUE_APP_ENABLE_SSO_GUARD=true
VUE_APP_OAUTH_CLIENT_ID=hi_rcrms
VUE_APP_OAUTH_CLIENT_SECRET=hi_rcrms

# 请求前缀（Nginx 代理用）
VUE_APP_API_PREFIX=/api
VUE_APP_SSO_PREFIX=/ssoservice
VUE_APP_OAUTH_PREFIX=/oauth

# SSO 登录页（完整地址，浏览器 302 跳转用）
VUE_APP_SSO_LOGIN_URL=http://portal.hi.bocsys.cn:8092

VUE_APP_COOKIE_DOMAIN=.hi.bocsys.cn
